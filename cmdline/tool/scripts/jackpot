JACKPOT_JAR=`readlink -f "$0"`
JACKPOT_JAR=`dirname "$JACKPOT_JAR"`/jackpot.jar
JAVA=java
if [ -n "$JAVA_HOME" -a -x "$JAVA_HOME/bin/java" ] ; then
    JAVA="$JAVA_HOME/bin/java"
fi
# the tool is compiled for Java 21; say so instead of failing with UnsupportedClassVersionError
JAVA_FEATURE=`"$JAVA" -XshowSettings:properties -version 2>&1 | sed -n 's/^ *java\.specification\.version *= *\(1\.\)\{0,1\}\([0-9]*\).*/\2/p'`
if [ -n "$JAVA_FEATURE" ] && [ "$JAVA_FEATURE" -lt 21 ] 2>/dev/null ; then
    echo "jackpot: Java $JAVA_FEATURE found at $JAVA; this tool needs Java 21 or newer (set JAVA_HOME)" >&2
    exit 1
fi
# "jackpot scan|rewrite|try|inspections|doctor|help ..." is the agent-oriented
# command line; anything else is the original flag-based interface.
MAIN=org.netbeans.modules.jackpot30.cmdline.Main
case "$1" in
    scan|rewrite|try|inspections|doctor|context|help) MAIN=org.netbeans.modules.jackpot30.cmdline.AgentMain ;;
esac
exec "$JAVA" -XX:+IgnoreUnrecognizedVMOptions \
     -Djava.awt.headless=true \
     --add-opens=java.base/java.net=ALL-UNNAMED \
     --add-opens=java.desktop/sun.awt=ALL-UNNAMED \
     --add-opens=java.desktop/javax.swing.text=ALL-UNNAMED \
     $JACKPOT_OPTS \
     -classpath `dirname "$JACKPOT_JAR"`/jackpot.jar $MAIN "$@"
